# syntax=docker/dockerfile:1.7
#
# Scoring image for Relearn Image and Relearn Agent. CI publishes a digest
# so cortex can pin it. A digest is not live-ready until the control plane's
# Lium template is `pin.image@digest`. Today `LiumClient::provision` ignores
# `InstanceSpec.image_digest` and rents `prism-recipe-v10`, so publishing
# this file does not fix a live 127 by itself.
#
# CUDA Ubuntu base — the pod harvest must boot, once wired. A slim CPython
# image is not that pod. `/usr/bin/relearn-image-eval` and
# `/usr/bin/relearn-agent-eval` are installed here as a *regular file*
# (COPY + install-cli.sh), not a symlink and not only on the contract-only
# slim image. Harvest SSH PATH is `/usr/bin:/bin`.
#
#   docker build -f eval/Dockerfile.scoring --build-arg CHALLENGE=image .
#   docker build -f eval/Dockerfile.scoring --build-arg CHALLENGE=agent .
#
# Build context is the repository root. The slim `eval/Dockerfile.challenge`
# is contract-only and is not the pin.
#
# No secret, judge endpoint, holdout record, or model weight is baked in here.

ARG BASE_IMAGE=nvidia/cuda:12.8.1-runtime-ubuntu24.04
FROM ${BASE_IMAGE}

# `image` or `agent`. Decides the entrypoint binary and the runtime extra.
ARG CHALLENGE=image
# `1` installs the model runtime so the image can score.
ARG WITH_RUNTIME=1
# Wheel index for the accelerator wheels, e.g. the CUDA index.
ARG TORCH_INDEX_URL=""
# Provenance only: the CortexLM/relearn commit this image was built from.
ARG RELEARN_GIT_SHA="unknown"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HUB_DISABLE_PROGRESS_BARS=1 \
    TRANSFORMERS_VERBOSITY=error \
    TOKENIZERS_PARALLELISM=false \
    RELEARN_GIT_SHA=${RELEARN_GIT_SHA} \
    RELEARN_CHALLENGE=${CHALLENGE}

# Python on /usr/bin (harvest PATH), sshd so the provider can land, tini so
# the harvest's SIGTERM reaches the scorer. CUDA Ubuntu does not ship these.
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl openssh-server \
        python3 python3-pip python3-venv; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tini \
        || curl -fsSL -o /usr/bin/tini \
            https://github.com/krallin/tini/releases/download/v0.19.0/tini-amd64; \
    if [ ! -x /usr/bin/tini ]; then \
        install -m 0755 "$(command -v tini)" /usr/bin/tini; \
    fi; \
    chmod 0755 /usr/bin/tini; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /run/sshd /root/.ssh; \
    chmod 700 /root/.ssh; \
    test -x /usr/bin/python3; \
    test -x /usr/bin/tini

WORKDIR /opt/relearn
COPY pyproject.toml README.md LICENSE ./
COPY eval/src ./eval/src
COPY eval/install-cli.sh /tmp/install-cli.sh
COPY eval/bin/relearn-image-eval /tmp/relearn-image-eval-launcher
COPY eval/bin/relearn-agent-eval /tmp/relearn-agent-eval-launcher

RUN set -eux; \
    case "${CHALLENGE}" in \
        image) extra="runtime-image"; binary="relearn-image-eval" ;; \
        agent) extra="runtime";       binary="relearn-agent-eval" ;; \
        *) echo "CHALLENGE must be 'image' or 'agent', got '${CHALLENGE}'" >&2; exit 1 ;; \
    esac; \
    python3 -m venv /opt/relearn-venv; \
    pip_cmd="/opt/relearn-venv/bin/pip"; \
    "${pip_cmd}" install --upgrade pip; \
    if [ -n "${TORCH_INDEX_URL}" ]; then \
        "${pip_cmd}" install --extra-index-url "${TORCH_INDEX_URL}" ".[${extra}]"; \
    elif [ "${WITH_RUNTIME}" = "1" ]; then \
        "${pip_cmd}" install ".[${extra}]"; \
    else \
        "${pip_cmd}" install "."; \
    fi; \
    CHALLENGE="${CHALLENGE}" sh /tmp/install-cli.sh; \
    rm -f /tmp/install-cli.sh \
          /tmp/relearn-image-eval-launcher \
          /tmp/relearn-agent-eval-launcher

# Regular file on the scoring path. Last word after pip so a console-script
# symlink cannot replace it. install-cli.sh already wrote one; this COPY is
# the same launcher, so `docker history` shows /usr/bin/relearn-*-eval as a
# real file layer on the CUDA image.
COPY eval/bin/relearn-image-eval /usr/bin/relearn-image-eval
COPY eval/bin/relearn-agent-eval /usr/bin/relearn-agent-eval
COPY eval/entrypoint-challenge.sh /usr/bin/relearn-challenge-entrypoint
RUN set -eux; \
    case "${CHALLENGE}" in \
        image) binary="relearn-image-eval" ;; \
        agent) binary="relearn-agent-eval" ;; \
        *) echo "CHALLENGE must be 'image' or 'agent', got '${CHALLENGE}'" >&2; exit 1 ;; \
    esac; \
    chmod 0755 /usr/bin/relearn-image-eval /usr/bin/relearn-agent-eval \
               /usr/bin/relearn-challenge-entrypoint; \
    test -f "/usr/bin/${binary}"; \
    test ! -L "/usr/bin/${binary}"; \
    test -x "/usr/bin/${binary}"; \
    env -i PATH=/usr/bin:/bin "/usr/bin/${binary}" --help >/dev/null; \
    env -i PATH=/usr/bin:/bin "/usr/bin/${binary}" score --help >/dev/null

# Where the control plane stages `request.json` over stdin. Never persisted:
# the request carries the private holdout for the length of the run only.
RUN set -eux; \
    case "${CHALLENGE}" in \
        image) mkdir -p /tmp/relearn_image_eval ;; \
        agent) mkdir -p /tmp/relearn_agent_eval ;; \
    esac

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/bin/relearn-challenge-entrypoint"]
CMD ["serve"]
